@startuml
abstract class ReviewableEntity {
    +String name
    +String address
    +Float averageRating
}

class Restaurant extends ReviewableEntity {
    +String cuisineType
    +String menuLink
}

class Hotel extends ReviewableEntity {
    +Integer stars
}

class Review {
    +String comment
    +Integer rating
    +Date date
    +Status status
    +submit()
}

class User {
    +String username
    +String email
}

User "1" -- "*" Review : creates
Review "*" -- "1" Restaurant : belongs to
@enduml