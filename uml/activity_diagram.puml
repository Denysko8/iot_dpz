@startuml
start
:User selects "Write a Review";
:Enter rating and text;
if (Is text empty?) then (yes)
  :Show error "Field required";
  stop
else (no)
  :Submit review;
  :System validates content;
  if (Spam detected?) then (yes)
    :Reject automatically;
  else (no)
    :Send to Moderator;
  endif
endif
stop
@enduml