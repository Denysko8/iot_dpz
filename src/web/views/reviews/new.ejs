<%- include('../partials/header') %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/reviews">Відгуки</a></li>
    <li class="breadcrumb-item active">Новий відгук</li>
  </ol>
</nav>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-7">
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white">
        <h4 class="mb-0"><i class="bi bi-star-fill me-2"></i>Новий відгук</h4>
      </div>
      <div class="card-body p-4">

        <% if (errors.length > 0) { %>
          <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
              <% errors.forEach(e => { %><li><%= e %></li><% }) %>
            </ul>
          </div>
        <% } %>

        <form action="/reviews" method="POST" novalidate>
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="hotelId" class="form-label fw-semibold">Готель</label>
              <select id="hotelId" name="hotelId" class="form-select" required>
                <option value="">— Оберіть готель —</option>
                <% hotels.forEach(hotel => { %>
                  <option value="<%= hotel.id %>"
                    <%= (parseInt(body.hotelId) === hotel.id) ? 'selected' : '' %>>
                    <%= hotel.name %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label for="userId" class="form-label fw-semibold">Користувач</label>
              <select id="userId" name="userId" class="form-select" required>
                <option value="">— Оберіть користувача —</option>
                <% users.forEach(user => { %>
                  <option value="<%= user.id %>"
                    <%= (parseInt(body.userId) === user.id) ? 'selected' : '' %>>
                    <%= user.username %>
                  </option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label for="rating" class="form-label fw-semibold">Оцінка (1–10)</label>
              <input type="number" id="rating" name="rating" class="form-control"
                     min="1" max="10" value="<%= body.rating || '' %>" placeholder="7" required />
            </div>
            <div class="col-md-8">
              <label for="status" class="form-label fw-semibold">Статус</label>
              <select id="status" name="status" class="form-select">
                <% Object.values(statuses).forEach(s => { %>
                  <option value="<%= s %>" <%= body.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="mb-4">
            <label for="comment" class="form-label fw-semibold">Коментар</label>
            <textarea id="comment" name="comment" class="form-control" rows="4"
                      placeholder="Напишіть ваш відгук..." required><%= body.comment || '' %></textarea>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
              <i class="bi bi-check-lg me-1"></i>Зберегти
            </button>
            <a href="/reviews" class="btn btn-outline-secondary flex-fill">
              <i class="bi bi-x me-1"></i>Скасувати
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
