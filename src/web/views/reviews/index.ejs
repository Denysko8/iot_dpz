<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h2 mb-0"><i class="bi bi-star text-warning me-2"></i>Відгуки</h1>
  <a href="/reviews/new" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i>Додати відгук
  </a>
</div>

<% if (reviews.length === 0) { %>
  <div class="alert alert-info text-center">
    <i class="bi bi-info-circle me-2"></i>Відгуків поки немає.
    <a href="/reviews/new">Додайте перший!</a>
  </div>
<% } else { %>
  <div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Готель</th>
          <th>Користувач</th>
          <th>Оцінка</th>
          <th>Коментар</th>
          <th>Дата</th>
          <th>Статус</th>
          <th class="text-end">Дії</th>
        </tr>
      </thead>
      <tbody>
        <% reviews.forEach((review, idx) => { %>
          <tr>
            <td class="text-muted"><%= idx + 1 %></td>
            <td>
              <a href="/hotels/<%= review.hotel ? review.hotel.id : '' %>">
                <%= review.hotel ? review.hotel.name : '—' %>
              </a>
            </td>
            <td>
              <a href="/users/<%= review.user ? review.user.id : '' %>">
                <%= review.user ? review.user.username : '—' %>
              </a>
            </td>
            <td>
              <span class="badge bg-primary fs-6"><%= review.rating %>/10</span>
            </td>
            <td class="text-truncate" style="max-width:220px;" title="<%= review.comment %>">
              <%= review.comment %>
            </td>
            <td class="text-nowrap text-muted small">
              <%= new Date(review.date).toLocaleDateString('uk-UA') %>
            </td>
            <td>
              <span class="badge <%=
                review.status === 'APPROVED' ? 'bg-success' :
                review.status === 'REJECTED' ? 'bg-danger' : 'bg-warning text-dark'
              %>"><%= review.status %></span>
            </td>
            <td class="text-end">
              <a href="/reviews/<%= review.id %>/edit" class="btn btn-sm btn-outline-secondary me-1">
                <i class="bi bi-pencil"></i>
              </a>
              <form action="/reviews/<%= review.id %>?_method=DELETE" method="POST" class="d-inline"
                    onsubmit="return confirm('Видалити відгук?')">
                <input type="hidden" name="_method" value="DELETE" />
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
