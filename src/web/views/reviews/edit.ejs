<%- include('../partials/header') %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/reviews">Відгуки</a></li>
    <li class="breadcrumb-item active">Редагувати відгук #<%= review.id %></li>
  </ol>
</nav>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-7">
    <div class="card shadow-sm">
      <div class="card-header bg-secondary text-white">
        <h4 class="mb-0"><i class="bi bi-pencil me-2"></i>Редагувати відгук</h4>
      </div>
      <div class="card-body p-4">

        <% if (errors.length > 0) { %>
          <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
              <% errors.forEach(e => { %><li><%= e %></li><% }) %>
            </ul>
          </div>
        <% } %>

        <div class="mb-3 p-3 bg-light rounded small">
          <strong>Готель:</strong> <%= review.hotel ? review.hotel.name : '—' %> &nbsp;|&nbsp;
          <strong>Автор:</strong> <%= review.user ? review.user.username : '—' %> &nbsp;|&nbsp;
          <strong>Дата:</strong> <%= new Date(review.date).toLocaleDateString('uk-UA') %>
        </div>

        <form action="/reviews/<%= review.id %>?_method=PUT" method="POST" novalidate>
          <input type="hidden" name="_method" value="PUT" />

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label for="rating" class="form-label fw-semibold">Оцінка (1–10)</label>
              <input type="number" id="rating" name="rating" class="form-control"
                     min="1" max="10" value="<%= review.rating %>" required />
            </div>
            <div class="col-md-8">
              <label for="status" class="form-label fw-semibold">Статус</label>
              <select id="status" name="status" class="form-select">
                <% Object.values(statuses).forEach(s => { %>
                  <option value="<%= s %>" <%= review.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="mb-4">
            <label for="comment" class="form-label fw-semibold">Коментар</label>
            <textarea id="comment" name="comment" class="form-control" rows="4" required><%= review.comment %></textarea>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning flex-fill">
              <i class="bi bi-check-lg me-1"></i>Зберегти зміни
            </button>
            <a href="/reviews" class="btn btn-outline-secondary flex-fill">
              <i class="bi bi-x me-1"></i>Скасувати
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
