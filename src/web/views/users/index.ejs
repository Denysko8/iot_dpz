<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h2 mb-0"><i class="bi bi-people text-primary me-2"></i>Користувачі</h1>
  <a href="/users/new" class="btn btn-primary">
    <i class="bi bi-person-plus me-1"></i>Додати користувача
  </a>
</div>

<% if (users.length === 0) { %>
  <div class="alert alert-info text-center">
    <i class="bi bi-info-circle me-2"></i>Користувачів поки немає.
    <a href="/users/new">Додайте першого!</a>
  </div>
<% } else { %>
  <div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Ім'я</th>
          <th>Email</th>
          <th class="text-end">Дії</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach((user, idx) => { %>
          <tr>
            <td class="text-muted"><%= idx + 1 %></td>
            <td>
              <a href="/users/<%= user.id %>" class="text-decoration-none fw-semibold">
                <i class="bi bi-person-circle me-1 text-primary"></i><%= user.username %>
              </a>
            </td>
            <td class="text-muted"><small><%= user.email %></small></td>
            <td class="text-end">
              <a href="/users/<%= user.id %>" class="btn btn-sm btn-outline-primary me-1">
                <i class="bi bi-eye"></i>
              </a>
              <a href="/users/<%= user.id %>/edit" class="btn btn-sm btn-outline-secondary me-1">
                <i class="bi bi-pencil"></i>
              </a>
              <form action="/users/<%= user.id %>?_method=DELETE" method="POST" class="d-inline"
                    onsubmit="return confirm('Видалити користувача «<%= user.username %>»?')">
                <input type="hidden" name="_method" value="DELETE" />
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
